        "selector": "JSXOpeningElement[name.name='Decor'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:capsuleGreen|capsulePurple|dotGrid|hexPurple|hexTeal)$/]",
        "message": "<Decor> kind must be one of 'capsuleGreen' | 'capsulePurple' | 'dotGrid' | 'hexPurple' | 'hexTeal'."
      },
